# === Telegram Bot ===
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_PROXY_URL=
ADMIN_TG_ID=111111111

# === Проекты и белые списки пользователей (ТЗ v2: З-2) ===
# Единственный источник прав: все ID внутри объекта имеют равные права.
# Пустой список объекта означает отсутствие доступа (никогда не "разрешено всем").
PROJECTS=OBJ1,OBJ2

PROJECT_OBJ1_CODE=ЦТП
PROJECT_OBJ1_NAME=Центральный тепловой пункт
PROJECT_OBJ1_CLOUD_OK=false
PROJECT_OBJ1_USERS=111111111, 222222222

PROJECT_OBJ2_CODE=КОРПУС-2
PROJECT_OBJ2_NAME=Корпус 2
PROJECT_OBJ2_CLOUD_OK=false
PROJECT_OBJ2_USERS=111111111, 333333333

# === PostgreSQL ===
POSTGRES_USER=pto_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=construction_registry
DATABASE_URL=postgresql://pto_admin:CHANGE_ME_STRONG_PASSWORD@db:5432/construction_registry

# === AI Agent: OpenRouter или локальный Hermes / Ollama / vLLM ===
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Для локального моста (llm_bridge.py)
HERMES_API_URL=http://host.docker.internal:8000/v1/chat/completions
HERMES_MODEL=hermes-agent
BRIDGE_AUTH_TOKEN=CHANGE_ME_SECURE_TOKEN
BRIDGE_ALLOWED_MODELS=z-ai/glm-5.3-flash,google/gemini-2.5-flash,anthropic/claude-3.5-sonnet,hermes-agent
