# === Telegram Bot ===
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_PROXY_URL=
ADMIN_TG_ID=YOUR_TELEGRAM_ID
# Белый список Telegram ID через запятую или пробел (например: 353745073, 123456789)
# Любой пользователь из этого списка получает полный доступ ко всем объектам и функциям бота:
ALLOWED_TELEGRAM_IDS=

# === PostgreSQL ===
POSTGRES_USER=pto_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=construction_registry
DATABASE_URL=postgresql://pto_admin:CHANGE_ME_STRONG_PASSWORD@db:5432/construction_registry

# === AI Agent: OpenRouter или локальный Hermes / Ollama / vLLM ===
# Для OpenRouter (любые облачные модели: Claude 3.5 Sonnet, GPT-4o, DeepSeek, Gemini):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Другие популярные модели:
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Для локального Hermes / vLLM / Ollama (оставьте OPENROUTER_API_KEY пустым):
HERMES_API_URL=http://host.docker.internal:8000/v1/chat/completions
HERMES_MODEL=hermes-agent

# === Internal Portal (VPN) — для L1+ документов ===
INTERNAL_PORTAL_URL=https://portal.company.internal/docs
